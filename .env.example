PORT=3000
NODE_ENV=development
# PostgreSQL connection string from your host (Render, Railway, Neon, etc.)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
# Generate a long random secret; never commit your real .env file.
SESSION_SECRET=replace-with-a-long-random-secret
# Optional: set true if your deployment is behind an HTTPS proxy.
TRUST_PROXY=false